# Secrets — never commit
# .env and any variant (.env.local, .env.production, etc.)
.env
.env.*
!.env.example          # keep the template (no real key in it)

# Keys, certs, and credential files
*.key
*.pem
*.pfx
*.p12
*.crt
credentials.json
secrets.json
secrets.yaml
service-account*.json

# Common secret filenames
*_secret*
*.secret

# Python
venv/
.venv/
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build / temp
*.tmp

# Author build context (local only, not part of course materials)
.context/
.claude
